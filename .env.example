# Copy to .env and edit. Never commit .env.
PORT=3000
# Public https address of the app (used for the QR code and the album link)
PUBLIC_URL=https://photos.example.com

# Admin password for /admin: long and random (e.g. `openssl rand -base64 24`)
ADMIN_KEY=change-me-to-a-long-random-string
# Album code for the /album?code=... link (not case sensitive). Empty = generated on first start
ALBUM_CODE=choose-an-album-code

# Shown on the welcome screen, album, admin, caption cards and the QR sheet.
# The first word is the big line, the rest the smaller line below it.
EVENT_TITLE=Birthday Party
# Optional big gold badge on the welcome screen, e.g. 50. Empty = none
EVENT_BADGE=

# Photos per guest. Every different task a guest completes gives one extra photo
PHOTO_LIMIT=15
DATA_DIR=./data
